# 服务配置
PORT=3001
NODE_ENV=development

# 数据库
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/compass?schema=public"

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 第三方服务密钥
TDT_KEY=your-tianditu-key
AMAP_KEY=your-amap-key
# 和风天气 JWT(Ed25519) 认证（推荐，见 https://dev.qweather.com/docs/configuration/authentication/）
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_PROJECT_ID=your-project-id
QWEATHER_CREDENTIAL_ID=your-credential-id
QWEATHER_PRIVATE_KEY_PATH=/path/to/ed25519-private.pem

# 短信服务
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 邮箱服务 (QQ邮箱 SMTP)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=your-email@qq.com

# AI 大模型（OpenAI 兼容接口）
# 文本对话
AI_CHAT_URL=https://your-host/v1/chat/completions
AI_CHAT_KEY=your-chat-key
AI_CHAT_MODEL=your-chat-model
AI_CHAT_SYSTEM=你是一个有帮助的助手。
# 图像（文生图 + 修图共用 key/model）
AI_IMAGE_URL=https://your-host/v1/images/generations
AI_IMAGE_EDIT_URL=https://your-host/v1/images/edits
AI_IMAGE_KEY=your-image-key
AI_IMAGE_MODEL=your-image-model
